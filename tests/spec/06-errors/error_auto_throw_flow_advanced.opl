# expect: 30 | fallback | err: step2 failed

# Auto-throw on method call results
class Api
  def fetch(id)
    if id > 0
      id * 10
    else
      return Error("not found")
    end
  end
end

def process(api, id)
  val = api.fetch(id)
  val * 3
end

# Early exit: auto-throw on Error return
def failing_pipeline()
  a = 10
  return Error("step2 failed")
end

api = Api.new()
r1 = process(api, 1)

# ? suppresses auto-throw, or provides fallback
r2 = process(api, -1)? or "fallback"

# Failing pipeline — ? catches the auto-throw
r3 = match failing_pipeline()?
  case Error(e)
    f"err: {e}"
  case _
    "ok"
end

print(f"{r1} | {r2} | {r3}")
