# expect: true | false | 42 | default | nope
# Error handling with ? operator, or keyword, and Error class

def succeed()
  42
end

def fail_with(msg)
  return Error(msg)
end

# ? on success — returns value (truthy)
ok_result = succeed()?
is_ok = if ok_result
  true
else
  false
end

# ? on failure — returns Error (falsy)
err_result = fail_with("nope")?
is_err = if err_result
  true
else
  false
end

# Direct value
val = succeed()

# ? or default
fallback = fail_with("nope")? or "default"

# .message on Error
err = fail_with("nope")?
msg = err.message

print(f"{is_ok} | {is_err} | {val} | {fallback} | {msg}")
