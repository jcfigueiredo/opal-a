# expect: 42 | err: fail | 21
# Auto-throw replaces ! propagation

def returns_ok()
  42
end

def returns_err()
  return Error("fail")
end

def chain_ok()
  a = returns_ok()
  a / 2
end

def chain_err()
  # returns_err() auto-throws, this line never completes
  a = returns_err()
  a + 1
end

# Direct call — returns 42
x = returns_ok()

# Auto-throw propagates the Error, ? catches it
result_err = chain_err()?

# Chained — success values pass through
result_ok = chain_ok()

err_str = match result_err
  case Error(msg)
    f"err: {msg}"
  case _
    f"ok"
end

print(f"{x} | {err_str} | {result_ok}")
