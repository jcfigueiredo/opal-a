# expect: 42 | caught: boom
# Auto-throw semantics — Error return throws automatically

def get_value()
  42
end

def get_error()
  return Error("boom")
end

# Success — no throw
ok_val = get_value()

# Error auto-throws — catch it with try/catch
caught = try
  get_error()
  "should not reach"
catch e
  f"caught: {e.message}"
end

print(f"{ok_val} | {caught}")
