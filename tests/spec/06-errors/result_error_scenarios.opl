# expect: true | default | ok: 10
# Error scenarios with ? operator and or fallback

def divide(a, b)
  if b == 0
    return Error("division by zero")
  end
  a / b
end

def calculate()
  x = divide(100, 5)
  y = divide(x, 2)
  z = divide(y, 0)
  z
end

# ? suppresses auto-throw, Error is falsy
r = calculate()?
is_err = not r
fallback = r or "default"

# Ok values work normally
inline_check = divide(100, 10)
msg = f"ok: {inline_check}"

print(f"{is_err} | {fallback} | {msg}")
